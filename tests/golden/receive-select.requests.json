      "textDocument": {
        "uri": "$LIB_URI",
        "languageId": "go",
        "version": 1,
        "text": "package lib\ntype hidden struct{}\nfunc (*hidden) Read(value int) int { return value }\ntype Callback func(value int) int\nfunc Channel() <-chan *hidden { return nil }\nfunc Functions() <-chan Callback { return nil }\n"
      }
    }
