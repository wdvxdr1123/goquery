  {
    "jsonrpc": "2.0",
    "method": "textDocument/didOpen",
    "params": {
      "textDocument": {
        "uri": "$FILE_URI",
        "languageId": "go",
        "version": 1,
        "text": "package main\nimport external \"example.test/typedef/lib\"\ntype hidden struct{}\nfunc (*hidden) Read(value string) string { return value }\nfunc Probe() {\n channel := external.Channel()\n received := <-channel\n copied := received\n paired, ok := <-channel\n _ = received.Read(1)\n _ = copied.Read(2)\n _ = paired.Read(3)\n function, functionOK := <-external.Functions()\n result := function(1)\n direct := (<-external.Functions())(2)\n select {\n case selected, selectedOK := <-channel:\n  \n  selectedCopy := selected\n  _ = selectedCopy.Read(4)\n  _, _ = selected, selectedOK\n }\n _, _, _, _ = ok, functionOK, result, direct\n}\nfunc Shadow(channel chan int) {\n select {\n case channel := <-channel /* header */:\n  \n  plus := channel + 1; _ = plus\n }\n}\n"
      }
    }
  },
