        "version": 1,
        "text": "package main\nimport external \"example.test/typedef/lib\"\nfunc Probe(value any) {\n switch chosen := value.(type) {\n case *external.Alias:\n  pointer := chosen; _ = pointer\n  _ = chosen.Read(1)\n  _ = func() { captured := chosen; _ = captured }\n case external.Alias:\n  concrete := chosen; _ = concrete\n  _ = chosen.Read(2)\n case func(input *external.Alias) *external.Alias:\n  callableCopy := chosen; _ = callableCopy\n  called := chosen(nil); _ = called\n case []*external.Alias:\n  indexed := chosen[0]; _ = indexed\n case nil:\n  nilCopy := chosen; _ = nilCopy\n case int, string:\n  multiCopy := chosen; _ = multiCopy\n default:\n  defaultCopy := chosen; _ = defaultCopy\n }\n switch initValue := value; narrowed := initValue.(type) {\n case *external.Alias:\n  fromInit := narrowed; _ = fromInit\n }\n switch value := value.(type) {\n case *external.Alias:\n  shadowed := value; _ = shadowed\n }\n}\n"
      }
    }
