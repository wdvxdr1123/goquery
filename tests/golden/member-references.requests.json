    "jsonrpc": "2.0",
    "method": "textDocument/didOpen",
    "params": {
      "textDocument": {
        "uri": "$FILE_URI",
        "languageId": "go",
        "version": 1,
        "text": "package main\nimport (lib \"example.test/project/lib\"; mid \"example.test/project/other\")\ntype Inner struct { Count int; 名 int; hidden int; Action func(x int) string }\nfunc (Inner) Run(x int) string { return \"\" }\ntype Outer struct { Inner; Label string }\ntype Other struct { Count string }\ntype Left struct { Inner }\ntype Right struct { Inner }\ntype Diamond struct { Left; Right }\ntype Block struct { Inner; Count string }\ntype Reader interface { Read(dst []byte) (int, error) }\ntype Wide interface { Reader; Close() error }\ntype Generic[T any] struct { Value T }\nfunc Factory() Outer { return Outer{} }\nfunc Probe(a Outer, b Diamond, c Block, r Wide, imported lib.Base) {\n _ = a.Count // promoted\n _ = a.Inner // embedded\n _ = b.Count // ambiguous\n _ = c.Count // shadow\n _ = r.Close // interface-own\n _ = r.Read // interface-promoted\n _ = imported.Export // imported\n _ = imported.hidden // private\n _ = imported.Fn // function-field\n _ = a.Inner.Count // field-chain\n _ = Factory().Count // call-receiver\n _ = imported.Next.Value // imported-chain\n _ = Outer{}.Count // composite-receiver\n _ = (a).Count // parenthesized\n _ = func() { _ = a.Count } // closure\n _ = \"🙂\"; _ = a.名 // unicode\n { a := Other{}; _ = a.Count } // local-shadow\n _ = Inner{Count: 1} // keyed-literal\n}\nfunc Unsupported(g Generic[int]) { _ = g.Value } // generic\nfunc KeyMap() { const Count = 1; _ = map[int]int{Count: 2} } // map-key\nfunc InvalidKey() { _ = Outer{Count: 1} } // promoted-key\nfunc MapField(a Outer) { _ = map[int]int{a.Count: 2} } // map-field-key\nfunc UseMembers(v Outer) { _ = v.hidden; _ = v.Action(1); _ = v.Count }\ntype NamedMap map[int]int\nfunc NamedKeys() { const Count = 1; _ = NamedMap{Count: 0} } // named-map-key\nfunc LocalKeys() { type LocalMap map[int]int; const Count = 1; _ = LocalMap{Count: 0} } // local-map-key\nfunc Indirect(v mid.Wrap) { _ = v.Export } // transitive-field\ntype Concrete struct{}\nfunc (Concrete) Read(dst []byte) (int,error) { return 0,nil }\nfunc Contract(v Concrete, r Reader) { _,_ = v.Read(nil); _,_ = r.Read(nil) }\n"
      }
    }
