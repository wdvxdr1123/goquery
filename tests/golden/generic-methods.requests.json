  {
    "jsonrpc": "2.0",
    "method": "textDocument/didOpen",
    "params": {
      "textDocument": {
        "uri": "$LIB_URI",
        "languageId": "go",
        "version": 1,
        "text": "package lib\ntype P struct { Wrong int }\ntype Cell[T any] struct { Value T; Fn func(v T) T }\nfunc (c Cell[P]) Get() P { return c.Value }\nfunc (c *Cell[Q]) Set(v Q, rest ...Q) (old Q) { return c.Value }\nfunc (c Cell[Renamed]) Copy() Cell[Renamed] { return c }\nfunc (c Cell[Self]) Split() (left Self, right Self) { return c.Value,c.Value }\nfunc (c Cell[X]) Transform(v X) X { return v }\nfunc (c Cell[X]) Apply(f func(X) X) X { return f(c.Value) }\ntype Wrap[T any] struct { Cell[T] }\ntype Alias[T any] = Wrap[T]\ntype Defined[T any] Cell[T]\nfunc (d Defined[Own]) Own(v Own) Own { return v }\ntype Pair[A,B any] struct { First A; Second B }\nfunc (p Pair[Y,X]) TakeSecond(v X) X { return v }\ntype Wide[T any] interface { Read(v T) T }\n"
      }
    }
  },
  {
    "jsonrpc": "2.0",
    "method": "textDocument/didOpen",
    "params": {
      "textDocument": {
        "uri": "$FILE_URI",
        "languageId": "go",
        "version": 1,
        "text": "package main\nimport lib \"example.test/project/lib\"\ntype Payload struct { Leaf int }\ntype Other struct { OtherOnly int }\ntype T struct { Wrong int }\nfunc Probe(c lib.Cell[Payload], p lib.Wrap[Payload], alias lib.Alias[Payload], d lib.Defined[Payload], pair lib.Pair[int,Payload], r lib.Wide[Payload], value Payload) {\n _ = c.Get() // get\n _ = c.Set(value, value, value) // variadic\n _ = p.Get() // promoted-get\n _ = alias.Get() // alias-get\n _ = d.Own(value) // own-method\n _ = pair.TakeSecond(value) // renamed-pair\n _ = c.Apply(c.Transform) // callback\n _ = c.Fn(value) // function-field\n _ = r.Read(value) // interface-method\n getter := c.Get\n _ = getter() // method-value\n _ = c.Get().Leaf // result-field\n _ = p.Get().Leaf // promoted-result\n _ = c.Copy().Value.Leaf // recursive-result\n left, right := c.Split(); _ = left.Leaf; _ = right.Leaf // multi-result\n _ = c.Fn(value).Leaf // field-result\n _ = r.Read(value).Leaf // interface-result\n _ = c.Ge // complete-get\n _ = p.Ge // complete-promoted\n _ = c.Se // complete-set\n _ = d.Ow // complete-own\n _ = d.Get() // no-inherited-method\n _ = c.Apply(c.Tr) // callback-completion\n}\nfunc Guard[T any](c lib.Cell[T]) { _ = c.Get().Wrong } // parameter-shadow\n"
      }
    }
  },
