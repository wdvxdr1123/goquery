        "version": 1,
        "text": "package lib\ntype hidden struct{}\nfunc (*hidden) Read(value int) int { return value }\ntype Alias = hidden\ntype Reader interface { Read(int) int }\nfunc Source() Reader { return &hidden{} }\n"
      }
    }
  },
  {
    "jsonrpc": "2.0",
    "method": "textDocument/didOpen",
    "params": {
      "textDocument": {
        "uri": "$FILE_URI",
        "languageId": "go",
        "version": 1,
        "text": "package main\nimport external \"example.test/typedef/lib\"\nfunc Probe(value any) {\n switch narrowed := value.(type) {\n case *external.Alias /* header */:\n  \n  pointer := narrowed; _ = pointer\n  _ = narrowed.Read(1)\n case ((nil)):\n  \n  nilCopy := narrowed; _ = nilCopy\n default:\n  \n  defaultCopy := narrowed; _ = defaultCopy\n }\n \n}\nfunc Shadow(value any) {\n switch value := value.(type) {\n case *external.Alias:\n  \n  copied := value; _ = copied\n  _ = value.Read(2)\n }\n}\n"
      }
    }
