[
  {
    "jsonrpc": "2.0",
    "id": 0,
    "method": "initialize",
    "params": {
      "rootUri": "$ROOT_URI",
      "capabilities": {
        "textDocument": {
          "completion": {
            "completionItem": {
              "snippetSupport": false
            }
          },
          "semanticTokens": {
            "requests": {
              "full": true
            },
            "tokenTypes": [
              "namespace",
              "type",
              "function",
              "method",
              "variable",
              "property",
              "parameter",
              "keyword",
              "string",
              "number",
              "comment",
              "operator",
              "typeParameter"
            ],
            "tokenModifiers": [
              "declaration",
              "definition",
              "readonly",
              "defaultLibrary",
              "static"
            ],
            "formats": [
              "relative"
            ]
          }
        }
      },
      "initializationOptions": {
        "goroot": "",
        "semanticTokens": true
      }
    }
  },
  {
    "jsonrpc": "2.0",
    "method": "textDocument/didOpen",
    "params": {
      "textDocument": {
        "uri": "$FILE_URI",
        "languageId": "go",
        "version": 1,
        "text": "package main\nfunc Bounds() (x, y int) { return }\nfunc Visit(iter func(_ int, v int) bool) { _ = iter }\nfunc Probe() {\n f := func(_ int, v int) (x int) { return v }\n _ = f\n}\ntype Walker interface { Walk(func(_ int, v int) (ok bool)) }\n"
      }
    }
  },
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "textDocument/semanticTokens/full",
    "params": {
      "textDocument": {
        "uri": "$FILE_URI"
      }
    }
  },
  {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "shutdown"
  },
  {
    "jsonrpc": "2.0",
    "method": "exit"
  }
]
