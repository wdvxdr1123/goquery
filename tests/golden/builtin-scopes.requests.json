        "text": "package main\nimport alias \"example.test/project/lib\"\ntype hidden struct{}\nfunc (hidden) Read(name int) string { return \"\" }\nfunc Probe[S alias.Lists](values S) {\n for _, appended := range append(values, values...) {\n  appended.Read(\"append\")\n }\n for _, made := range make(S, 2) {\n  made.Read(\"make\")\n }\n seed := alias.Seed()\n copied := append(seed, seed...)\n for _, concrete := range copied {\n  concrete.Read(\"concrete\")\n }\n allocated := new(seed[0])\n item := *allocated\n item.Read(\"new\")\n length := len(append(values, values...))\n copiedCount := copy(values, values)\n _,_ = length,copiedCount\n}\n"
      }
