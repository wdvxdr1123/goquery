    "jsonrpc": "2.0",
    "method": "textDocument/didOpen",
    "params": {
      "textDocument": {
        "uri": "$SIBLING_URI",
        "languageId": "go",
        "version": 1,
        "text": "package main\nimport bounds \"example.test/project/other\"\nvar _ = bounds.Public\ntype hidden struct{}\nfunc (hidden) Read(name int) string { return \"\" }\nfunc (box *Holder[Values,Key]) Probe(key Key,keys []Key) {\n for _, direct := range box.Values[key] {\n  direct.Read(\"direct\")\n }\n for _, fromSlice := range box.Values[keys[0]] {\n  fromSlice.Read(\"slice key\")\n }\n for key := range box.Values {\n  for _, fromRange := range box.Values[key] {\n   fromRange.Read(\"range key\")\n  }\n }\n for _, sliced := range box.Values[key][1:] {\n  sliced.Read(\"slice value\")\n }\n {\n  Key := 1\n  _ = Key\n  var copied Values = box.Values\n  for _, shadowed := range copied[key] {\n   shadowed.Read(\"shadow\")\n  }\n }\n}\n"
      }
    }
