        "version": 1,
        "text": "package scoped\nimport factory \"example.test/factory\"\nfunc Identity[T any](value T) T { return value }\nfunc Slice[T any](value T) []T { return []T{value} }\nfunc Mapping[T any](value T) map[string]T { return map[string]T{\"k\":value} }\nfunc Array[T any](value T) [2]T { return [2]T{value,value} }\nfunc PointerArray[T any](value T) *[2]T { return &[2]T{value,value} }\nfunc Sequence[T any](value T) func(func(T) bool) { return func(yield func(T) bool) { yield(value) } }\nfunc Channel[T any](value T) <-chan T { return nil }\ntype hidden struct{ Wrong int }\nfunc (hidden) Read(name int) string { return \"\" }\nfunc Probe() {\n hidden := factory.New().Hidden()\n for _, fromSlice := range Slice(hidden)[:] {\n  fromSlice.Read(\"slice\")\n  copied := Identity(fromSlice)\n  copied.Read(\"copy\")\n }\n for _, fromArray := range Array(hidden) {\n  fromArray.Read(\"array\")\n }\n for _, fromPointer := range PointerArray(hidden) {\n  fromPointer.Read(\"pointer\")\n }\n for _, fromMap := range Mapping(hidden) {\n  fromMap.Read(\"map\")\n }\n for fromSequence := range Sequence(hidden) {\n  fromSequence.Read(\"sequence\")\n }\n for fromChannel := range Channel(hidden) {\n  fromChannel.Read(\"channel\")\n }\n}\n"
