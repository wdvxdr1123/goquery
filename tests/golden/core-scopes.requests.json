        "text": "package main\nimport \"example.test/project/lib\"\ntype hidden struct{}\nfunc (hidden) Read(name int) string { return \"\" }\nfunc Slice[S lib.SliceBound](values S) {\n for _, sliced := range values {\n  sliced.Read(\"slice\")\n }\n}\nfunc Mapping[K comparable,S lib.MapBound[K]](values S) {\n for _, mapped := range values {\n  mapped.Read(\"map\")\n }\n}\nfunc Channels[C lib.ChannelBound](values C) {\n for channeled := range values {\n  channeled.Read(\"channel\")\n }\n}\nfunc Functions[F lib.FunctionBound](values F) {\n for iterated := range values {\n  iterated.Read(\"function\")\n }\n}\nfunc Callback[Y lib.CallbackBound,F lib.WithCallback[Y]](values F) {\n for callback := range values {\n  callback.Read(\"callback\")\n }\n}\n"
      }
