        "text": "package main\nimport external \"example.test/typedef/lib\"\nfunc Probe(value any) {\n source := external.Source()\n asserted := source.(*external.Alias)\n paired, ok := source.(*external.Alias)\n copied := paired\n slice := value.([]*external.Alias)\n indexed := slice[0]\n callable := value.(func() *external.Alias)\n called := callable()\n direct := value.(func() *external.Alias)()\n _ = asserted.Read(1)\n _ = paired.Read(2)\n _ = copied.Read(3)\n _ = indexed.Read(4)\n _, _, _ = ok, called, direct\n}\n"
      }
