[
  {
    "jsonrpc": "2.0",
    "id": 0,
    "method": "initialize",
    "params": {
      "workspaceFolders": [
        {
          "uri": "$ROOT_URI",
          "name": "module"
        },
        {
          "uri": "$GEN_ROOT_URI",
          "name": "explicit"
        }
      ],
      "capabilities": {}
    }
  },
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "workspace/symbol",
    "params": {
      "query": "Generated"
    }
  },
  {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "textDocument/references",
    "params": {
      "textDocument": {
        "uri": "$FILE_URI"
      },
      "position": {
        "line": 1,
        "character": 5
      },
      "context": {
        "includeDeclaration": true
      }
    }
  },
  {
    "jsonrpc": "2.0",
    "id": 3,
    "method": "shutdown"
  },
  {
    "jsonrpc": "2.0",
    "method": "exit"
  }
]
