        "uri": "$FILE_URI",
        "languageId": "go",
        "version": 1,
        "text": "package main\nimport lib \"example.test/project/lib\"\ntype Payload struct { Leaf int }\ntype T struct { Wrong int }\nfunc Probe(c lib.Cell[Payload], fn func() Payload, named lib.Factory[Payload], alias lib.Alias[Payload], defined lib.Defined[Payload], foreign lib.ForeignFactory, pointer *lib.Factory[Payload]) {\n get := c.Get\n a := get()\n _ = a.Leaf // method-result\n copied := get\n _ = copied().Leaf // copied-result\n pair := c.Pair\n left,right := pair()\n _ = left.Leaf // left-result\n _ = right.Leaf // right-result\n field := c.Fn\n _ = field().Leaf // field-result\n _ = fn().Leaf // parameter-result\n _ = named().Leaf // named-result\n _ = alias().Leaf // alias-result\n _ = defined().Leaf // defined-result\n _ = foreign().Remote // foreign-result\n makeValue := lib.Make\n _ = makeValue().Remote // imported-function\n literal := func() Payload { return Payload{} }\n _ = literal().Leaf // literal-result\n _ = (func() Payload { return Payload{} })().Leaf // direct-literal\n var declared (func() Payload) = get\n _ = declared().Leaf // declared-result\n type LocalFactory func() Payload\n var local LocalFactory = get\n _ = local().Leaf // local-type-result\n _ = copied().Le // completion\n { get := 1; _ = get().Leaf } // shadowed-noncallable\n _ = pointer().Leaf // pointer-noncallable\n}\nfunc Guard[T any](f lib.Factory[T]) { _ = f().Wrong } // parameter-shadow\n"
      }
    }
