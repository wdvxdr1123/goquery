on", "links": null}, {"text": "//\t    Pos           string   // position of error (if present, file:line:col)", "links": null}, {"text": "// a site serving from a fixed file system (including a file:/// URL)", "links": null}, {"text": "\"file:///\"", "links": null}, {"text": "// and has a file:// URL instead of http:// or https://", "links": null}, {"text": "// If we use a file:// URL to access the local directory,", "links": null}, {"text": "\"invalid file:// proxy URL with non-path elements: %s\"", "links": null}, {"text": "// Exception #1: using GOPROXY=file:// to test a distpack.", "links": null}, {"text": "\"removed GODEBUG %q set to old value %q (https://go.dev/doc/godebug#go-1%v)\"", "links": null}, {"text": "// Errors returned by modfile.Parse begin with file:line.", "links": null}, {"text": "\"ssh://user@example.com/foo.git\"", "links": null}, {"text": "\"ssh://user@example.com/path/to/repo.hg\"", "links": null}, {"text": "\"serving svn on svn://%v\"", "links": null}, {"text": "\"serving on http://%s:%d/\"", "links": null}, {"text": "// it as \"file:line: message\" diagnostics on stderr.", "links": null}, {"text": "// prints it (to stderr) in \"file:line: message\" form.", "links": null}, {"text": "// file://host.example.com/", "links": null}, {"text": "// file://host.example.com/Share/path/to/file", "links": null}, {"text": "// file:///C:/path/to/file", "links": null}, {"text": "// file:///path/to/file", "links": null}, {"text": "`file:///path/to/file`", "links": null}, {"text": "`file:/path/to/file`", "links": null}, {"text": "`file://localhost/path/to/file`", "links": null}, {"text": "`file://host.example.com/path/to/file`", "links": null}]}